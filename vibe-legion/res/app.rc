#include <winver.h>

#define RT_MANIFEST_ID 24

1 RT_MANIFEST_ID "app.manifest"
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Vibe Hand"
            VALUE "FileDescription", "Vibe Hand - gesture control"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "VibeHand"
            VALUE "OriginalFilename", "VibeHand.exe"
            VALUE "ProductName", "Vibe Hand"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
