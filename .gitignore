# Dart / Flutter build state
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml

# Resolved dependency versions are left untracked on purpose: CI resolves them
# against whatever stable Flutter the runner has, matching how the platform
# runners are generated rather than frozen.
pubspec.lock

# Platform runners are generated by `flutter create` in CI and by
# tool/bootstrap_platforms.sh locally, never committed. See README.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# Built catalog. Both are derived from data/catalog/*.jsonl by
# tool/build_catalog.py: assets/catalog.db is the copy that ships inside the
# app, dist/ holds the release assets. Neither is committed — the catalog is
# what changes most often here, and a multi-megabyte binary that changes with
# it does not belong in the history. The generated Dart is committed, because
# it has to compile.
#
#   python3 tool/build_catalog.py    # before flutter run / build / test
/assets/catalog.db
/dist/

# flutter create regenerates these on every CI run; the runner directories
# above are ignored for the same reason.
/.metadata
