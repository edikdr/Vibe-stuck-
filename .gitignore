# Dart / Flutter build state
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml

# Resolved dependency versions are left untracked on purpose: CI resolves them
# against whatever stable Flutter the runner has, matching how the platform
# runners are generated rather than frozen.
pubspec.lock

# Platform runners are generated by `flutter create` in CI and by
# tool/bootstrap_platforms.sh locally, never committed. See README.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# flutter create regenerates these on every CI run; the runner directories
# above are ignored for the same reason.
/.metadata
