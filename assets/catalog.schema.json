{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VibeStack Atlas catalog",
  "description": "Contract for assets/catalog.json and for any custom feed loaded over HTTPS.",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 3 },
    "catalogVersion": { "type": "string" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "labels"],
        "properties": {
          "id": { "type": "string" },
          "labels": {
            "type": "object",
            "required": ["en", "ru", "de"],
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "name", "kind", "category", "summary", "url", "access", "compatibility", "tags", "tip", "verifiedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["api", "library", "mcp", "skill"] },
        "category": { "type": "string" },
        "categoryGroup": { "enum": ["ai", "frontend", "backend", "devtools", "data", "media", "skills"] },
        "summary": { "type": "string", "minLength": 8 },
        "url": { "type": "string", "pattern": "^https://" },
        "access": { "enum": ["noKey", "freeTier", "openSource", "free", "mixed", "paid"] },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["codex", "claude", "both"] }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "tip": { "type": "string" },
        "install": { "type": "string" },
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string" },
        "sourceLanguage": { "enum": ["ru", "en", "de"] },
        "localizedSummary": { "type": "object", "additionalProperties": { "type": "string" } },
        "localizedTip": { "type": "object", "additionalProperties": { "type": "string" } },
        "showcases": { "type": "array", "items": { "$ref": "#/$defs/showcase" } },
        "pricing": { "$ref": "#/$defs/pricing" }
      }
    },
    "showcase": {
      "description": "A real project, site or gallery built with this entry. When image is absent the app renders a live screenshot of url through the configured preview provider.",
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "kind": { "enum": ["gallery", "site", "demo", "code"] },
        "note": { "type": "string" },
        "image": { "type": "string", "pattern": "^https://" },
        "localizedNote": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "model": { "enum": ["free", "openSource", "freemium", "usage", "subscription", "credits", "commission", "hybrid"] },
        "from": { "type": "string" },
        "freeQuota": { "type": "string" },
        "url": { "type": "string" },
        "currency": { "type": "string" },
        "checkedAt": { "type": "string" }
      }
    }
  }
}
